# Optional: source builds with hosted features. Everything below is off by default;
# the open source workspace needs none of it. Do not add server-side secrets to this file.

# Clerk instance. To use your own, get these from the Clerk Dashboard
# under API keys, JWT templates, and OAuth applications.
# LOGICPACKS_CLERK_PUBLISHABLE_KEY=pk_live_...
# LOGICPACKS_CLERK_JWT_TEMPLATE=lp-relay
# LOGICPACKS_CLERK_CLI_OAUTH_CLIENT_ID=...

# Optional: signed macOS passkey builds. The RP domain defaults to the Frontend API
# hostname encoded in LOGICPACKS_CLERK_PUBLISHABLE_KEY. Set the override only when Clerk
# returns a different RP ID or when multiple domains must be entitled.
# LOGICPACKS_APPLE_TEAM_ID=ABC1234567
# LOGICPACKS_MACOS_PROVISIONING_PROFILE=/absolute/path/to/logicpacks.provisionprofile
# LOGICPACKS_CLERK_PASSKEY_RP_DOMAINS=example.clerk.accounts.dev,clerk.example.com

# Relay for hosted connections.
# LOGICPACKS_RELAY_URL=https://relay.example.com

# Optional: hosted app origin used by the CLI's out-of-band OAuth flow.
# Defaults to https://app.logicpacks.io; override to test against a staging deployment.
# LOGICPACKS_HOSTED_APP_URL=https://nightly.app.logicpacks.io
